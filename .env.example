DATABASE_URL="mysql://rebx:rebx_dev_password@localhost:3306/rebx"

# Generate with: npx auth secret
AUTH_SECRET=""

# From https://resend.com/api-keys
RESEND_API_KEY=""
# Optional: only needed once a custom domain is verified in Resend
RESEND_FROM_EMAIL=""

# DigitalOcean Spaces (listing photo uploads) — create a Space + API key at
# https://cloud.digitalocean.com/spaces
SPACES_KEY=""
SPACES_SECRET=""
SPACES_REGION="nyc3"
SPACES_BUCKET=""
# Optional: only needed if the Space has a CDN endpoint enabled
SPACES_CDN_ENDPOINT=""

# WhatsApp Business Cloud API (optional; new-lead alerts to agents who opted in)
# WHATSAPP_ACCESS_TOKEN=            # permanent System User token. Keep secret.
# WHATSAPP_PHONE_NUMBER_ID=         # Phone number ID from Meta (not the phone number)
# WHATSAPP_API_VERSION=v25.0
# WHATSAPP_DEFAULT_COUNTRY_CODE=91  # used for numbers typed without a country code
# WHATSAPP_TEMPLATE_NEW_LEAD=new_lead_alert
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
