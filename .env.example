DATABASE_URL="mysql://rebx:rebx_dev_password@localhost:3306/rebx"

# Generate with: npx auth secret
AUTH_SECRET=""

# From https://resend.com/api-keys
RESEND_API_KEY=""
# Optional: only needed once a custom domain is verified in Resend
RESEND_FROM_EMAIL=""

# DigitalOcean Spaces (listing photos & production video studio images)
# Create a Space + API key at https://cloud.digitalocean.com/spaces
SPACES_KEY=""
SPACES_SECRET=""
SPACES_REGION="nyc3"
SPACES_BUCKET=""
# Optional: only needed if the Space has a CDN endpoint enabled
SPACES_CDN_ENDPOINT=""

# AI Video Studio Asset Storage Provider (Development vs Production):
# - Local development defaults automatically to "local" (private storage/video-studio/) when unset.
# - Production (NODE_ENV="production") ALWAYS uses "spaces" and rejects "local".
# - Only uncomment STORAGE_PROVIDER="spaces" locally if you want local dev to upload to Spaces.
# STORAGE_PROVIDER="local"

# Google Gemini API (optional: for AI Video Studio script generation)
# Obtain a free or paid API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Sarvam AI Text-to-Speech (optional: for AI Video Studio scene voiceover generation)
# Obtain an API key from https://dashboard.sarvam.ai/
SARVAM_API_KEY=""
# SARVAM_TTS_MODEL="bulbul:v3"

# WhatsApp Business Cloud API (optional; new-lead alerts to agents who opted in)
# WHATSAPP_ACCESS_TOKEN=            # permanent System User token. Keep secret.
# WHATSAPP_PHONE_NUMBER_ID=         # Phone number ID from Meta (not the phone number)
# WHATSAPP_API_VERSION=v25.0
# WHATSAPP_DEFAULT_COUNTRY_CODE=91  # used for numbers typed without a country code
# WHATSAPP_TEMPLATE_NEW_LEAD=new_lead_alert
# WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Site-visit reminders: /api/cron/site-visit-reminders (GET or POST). Production returns 401 unless this is set.
# Call it every 10-15 minutes from a scheduler with the header  Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# AI Video Studio Background Render Worker (Phase 3 Part C3.1)
# Main REBX Next.js app variables:
RENDER_WORKER_ENABLED="false"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RENDER_WORKER_SECRET=""

# Standalone worker process variables (worker/video-renderer/):
# Keep "false" until Part C3.3 output storage upload & completion are enabled.
# RENDER_WORKER_PROCESSING_ENABLED="false"
# RENDER_API_BASE_URL="http://localhost:3000"
# RENDER_WORKER_ID="rebx-local-worker-1"
# RENDER_POLL_INTERVAL_MS="5000"
# RENDER_REQUEST_TIMEOUT_MS="15000"
# RENDER_LEASE_DURATION_SEC="300"
# RENDER_HEARTBEAT_INTERVAL_MS="30000"
# RENDER_FFMPEG_TIMEOUT_MS="300000"
# Optional isolated temp workspace directory for downloaded scene assets (defaults to OS temp dir):
# RENDER_WORKER_TEMP_DIR=""
# Optional custom FFmpeg/FFprobe executable paths (if not on system PATH):
# FFMPEG_PATH=""
# FFPROBE_PATH=""
# FFMPEG_PROBE_TIMEOUT_MS="4000"

