# REBX video render worker (copy to .env.worker on the worker host; never commit it).

# Must equal RENDER_WORKER_SECRET on the main REBX app.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RENDER_WORKER_SECRET=

# Public URL of the REBX app.
RENDER_API_BASE_URL=https://rebx.app

# Unique per worker instance (letters, digits . _ : - only).
RENDER_WORKER_ID=rebx-render-worker-1

# The worker stays idle (claims nothing) unless this is "true".
RENDER_WORKER_PROCESSING_ENABLED=true

# Optional tuning (defaults shown in worker/video-renderer/README.md).
# RENDER_POLL_INTERVAL_MS=5000
# RENDER_FFMPEG_TIMEOUT_MS=300000
